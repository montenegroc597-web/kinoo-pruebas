{
  "name": "kinoo-pruebas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:prueba": "npm run dev -w @kinoo/prueba",
    "dev:panel": "npm run dev -w @kinoo/panel",
    "build": "npm run build -w @kinoo/prueba && npm run build -w @kinoo/panel",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "mock": "node e2e/mock-backend.mjs",
    "export-data": "node scripts/export-sheet.mjs",
    "hojas-sql": "node scripts/hojas-sql.mjs",
    "carga": "node scripts/carga.mjs",
    "importar-prototipo": "node scripts/importar-prototipo.mjs",
    "protocolo-texto": "node scripts/protocolo-texto.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.7",
    "@playwright/test": "^1.48.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^30.1.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
